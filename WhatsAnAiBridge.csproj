<Project Sdk="Microsoft.NET.Sdk">
  <!-- One project for both games. $(Game) is decided in Directory.Build.props (poe1 | poe2).
       Shared\ is game-agnostic; Poe1\ / Poe2\ hold each game's partial class and global usings.
       The HUD's Plugins\Source\Whats An AI Bridge must point at THIS (repo root) folder. -->
  <!-- No <TargetFramework> here on purpose: it is set per game in Directory.Build.props
       (the PoE2 HUD rewrites any TargetFramework it finds in a plugin .csproj). -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>WhatsAnAiBridge</RootNamespace>
    <AssemblyName>WhatsAnAiBridge</AssemblyName>
    <LangVersion>latest</LangVersion>
    <DebugType>embedded</DebugType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <DefineConstants Condition="'$(Game)' == 'poe1'">$(DefineConstants);POE1</DefineConstants>
    <DefineConstants Condition="'$(Game)' == 'poe2'">$(DefineConstants);POE2</DefineConstants>
    <PathMap>$(MSBuildProjectDirectory)=$(MSBuildProjectName)</PathMap>
    <EmbedAllSources>true</EmbedAllSources>
    <!--Don't bother setting anything to do with the output path, HUD will do it for you if you put the source code inside Plugins/Source-->
  </PropertyGroup>
  <!-- Reference the HUD we're sitting in; fall back to the env var for dev builds outside a HUD. -->
  <PropertyGroup Condition="'$(Game)' == 'poe1'">
    <GameRefDir Condition="Exists('$(HudDir)\ExileCore.dll')">$(HudDir)</GameRefDir>
    <GameRefDir Condition="'$(GameRefDir)' == ''">$(exapiPackage)</GameRefDir>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Game)' == 'poe2'">
    <GameRefDir Condition="Exists('$(HudDir)\ExileCore2.dll')">$(HudDir)</GameRefDir>
    <GameRefDir Condition="'$(GameRefDir)' == ''">$(exilecore2Package)</GameRefDir>
  </PropertyGroup>
  <!-- Compile Shared\ plus only this game's folder (default glob picks up everything). -->
  <ItemGroup>
    <Compile Remove="obj\**" />
    <Compile Remove="Poe2\**" Condition="'$(Game)' == 'poe1'" />
    <Compile Remove="Poe1\**" Condition="'$(Game)' == 'poe2'" />
  </ItemGroup>
  <ItemGroup Condition="'$(Game)' == 'poe1'">
    <Reference Include="ExileCore">
      <HintPath>$(GameRefDir)\ExileCore.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="GameOffsets">
      <HintPath>$(GameRefDir)\GameOffsets.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <PackageReference Include="SharpDX.Mathematics" Version="4.2.0" />
  </ItemGroup>
  <ItemGroup Condition="'$(Game)' == 'poe2'">
    <Reference Include="ExileCore2">
      <HintPath>$(GameRefDir)\ExileCore2.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="GameOffsets2">
      <HintPath>$(GameRefDir)\GameOffsets2.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(GameRefDir)\Newtonsoft.Json.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <PackageReference Include="ImGui.NET" Version="1.90.0.1" />
    <!-- Runtime patching of the HUD's own unprotected managed code for pipeline.trace (Shared\PipelineTrace.cs). MIT. -->
    <PackageReference Include="Lib.Harmony" Version="2.4.2" GeneratePathProperty="true" />
  </ItemGroup>
  <!-- A class library does not copy NuGet assemblies to its output, and the HUDs load a plugin's dependencies from its
       output folder (<name>.dll next to the plugin): copy 0Harmony there. The other packages ship with the HUDs. -->
  <ItemGroup Condition="'$(PkgLib_Harmony)' != ''">
    <None Include="$(PkgLib_Harmony)\lib\$(TargetFramework.Replace('-windows', ''))\0Harmony.dll" Link="0Harmony.dll"
          CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>
  <!-- Roslyn scripting for script.run (Shared\ScriptRunner.cs): both HUDs ship these DLLs. -->
  <ItemGroup>
    <Reference Include="Microsoft.CodeAnalysis">
      <HintPath>$(GameRefDir)\Microsoft.CodeAnalysis.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Microsoft.CodeAnalysis.CSharp">
      <HintPath>$(GameRefDir)\Microsoft.CodeAnalysis.CSharp.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Microsoft.CodeAnalysis.Scripting">
      <HintPath>$(GameRefDir)\Microsoft.CodeAnalysis.Scripting.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Microsoft.CodeAnalysis.CSharp.Scripting">
      <HintPath>$(GameRefDir)\Microsoft.CodeAnalysis.CSharp.Scripting.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>
</Project>